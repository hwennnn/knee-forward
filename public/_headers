# Cache policy for the static host in front of dist/.
# Hashed Vite files can stay cached. HTML and the service worker must revalidate.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/today/*
  Cache-Control: no-cache

/plan/*
  Cache-Control: no-cache

/learn/*
  Cache-Control: no-cache

/progress/*
  Cache-Control: no-cache
